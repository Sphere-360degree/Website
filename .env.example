# SPHERIONIX — Environment Variables Template
# Copy to .env.local for local overrides. NEVER commit secrets or private keys to git.

# Application URL
VITE_SITE_URL=https://www.spherionix.com

# Lead & Contact API Endpoint (Optional: e.g. webhook URL, serverless function, or CRM endpoint)
# If left empty, the application uses local client-side validation and simulated dispatch.
VITE_LEAD_API_URL=

# Analytics Tracking ID (Optional: e.g. Google Analytics G-XXXXXXXXXX)
VITE_GA_TRACKING_ID=
